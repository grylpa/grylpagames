[debug]

settings/gdscript/always_track_call_stacks=true
gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=680
window/size/viewport_height=788
window/size/mode=2
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[editor_plugins]

enabled=PackedStringArray("res://addons/ver_tools/plugin.cfg")

[gui]

theme/custom_font="uid://bgmv6k842mxxs"

[importer_defaults]

oggvorbisstr={
"bar_beats": 4,
"beat_count": 0,
"bpm": 0,
"loop": false,
"loop_offset": 0
}

